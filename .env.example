# Copy to .env and fill in the values (no quotes, no spaces around =).
# Only placeholders here: never commit real keys. Check with: python manage.py check-config

# --- Research agents (REQUIRED) ---------------------------------------------------
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# Tavily web search: https://app.tavily.com
TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE
# Optional: any LangChain provider:model string
MODEL=openai:gpt-5.4-mini

# --- Persistent conversation memory (REQUIRED) ----------------------------------
# PostgreSQL connection string. Neon: Neon console > your project > Connect (keep ?sslmode=require).
# Local Postgres outside Docker: postgresql://mra:<password>@localhost:5432/mra
# (When you use docker-compose.local-db.yml, the containers ignore this and use POSTGRES_PASSWORD.)
DATABASE_URL=YOUR_POSTGRESQL_CONNECTION_STRING_HERE

# Only for the local Docker database (docker-compose.local-db.yml). Choose any password,
# letters and digits only. Changing it later does not change an existing database volume.
POSTGRES_PASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD_HERE

# --- Langfuse tracing & evaluation (OPTIONAL) ------------------------------------
# Keys: Langfuse > Project settings > API keys. Leave the placeholders to run without tracing,
# or set LANGFUSE_TRACING_ENABLED=false to turn tracing off explicitly.
LANGFUSE_PUBLIC_KEY=YOUR_LANGFUSE_PUBLIC_KEY_HERE
LANGFUSE_SECRET_KEY=YOUR_LANGFUSE_SECRET_KEY_HERE
# Region: https://cloud.langfuse.com (EU) | https://us.cloud.langfuse.com (US) | your self-hosted URL
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true

# --- Optional extras (uncomment to use) -------------------------------------------
# Judge model for paid LLM-as-judge evaluation (default: MODEL)
# JUDGE_MODEL=openai:gpt-5.4-mini
# Owner recorded on conversations (single-user app; there is no login)
# APP_OWNER_ID=local
# Host ports used by docker compose
# APP_PORT=8501
# POSTGRES_PORT=5432
